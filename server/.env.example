CARVISTA_ADMIN_USER=admin
CARVISTA_ADMIN_PASSWORD=change-me
CARVISTA_SESSION_SECRET=change-me-to-a-long-random-string
# App 下载图片时使用的外网地址。群晖反代到 127.0.0.1 时必须填这个，否则手机会去连自己。
CARVISTA_PUBLIC_URL=https://carplay.dokor.cn
# 群晖上改成实际目录；本地开发可留空，默认使用 server/data
CARVISTA_DATA_DIR=/volume1/docker/carvista/data
