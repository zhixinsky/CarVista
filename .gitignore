# Public release tree: track only README, docs assets, and IPA.
# Everything else (source, Xcode, scripts, DerivedData, etc.) stays private.

*
!.gitignore

# README
!README.md
!README.ja.md

# Images referenced by README
!docs/
!docs/**

# Release IPA only (not DerivedData or other build junk)
!build/
build/*
!build/*.ipa

# Local redevelopment source
!ios/
!ios/**
ios/DerivedData/
ios/*.xcodeproj/
!.github/
!.github/workflows/
!.github/workflows/*.yml
!ios/output/

# Admin service
!server/
!server/**
server/.env
server/data/
server/**/__pycache__/
server/.pytest_cache/
